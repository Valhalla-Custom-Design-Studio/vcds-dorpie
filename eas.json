{
  "cli": { "version": ">= 10.0.0" },
  "build": {
    "preview": {
      "android": { "buildType": "apk" },
      "env": { "NODE_ENV": "staging" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "NODE_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "android": { "serviceAccountKeyPath": "./google-services.json", "track": "internal" }
    }
  }
}
