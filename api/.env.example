NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vcds_user:CHANGE_ME@localhost:5432/vcds_db
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_EXPIRES_IN=7d
PAYFAST_MERCHANT_ID=CHANGE_ME
PAYFAST_MERCHANT_KEY=CHANGE_ME
PAYFAST_PASSPHRASE=CHANGE_ME
PAYFAST_RETURN_URL=https://yourdomain.co.za/payment/success
PAYFAST_CANCEL_URL=https://yourdomain.co.za/payment/cancel
PAYFAST_NOTIFY_URL=https://yourdomain.co.za/api/v1/payments/itn
PAYFAST_SANDBOX=true
ALLOWED_ORIGINS=http://localhost:3000
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100


# ── ODIN API INTEGRATIONS ──────────────────────────────
# Mapping
MAPBOX_ACCESS_TOKEN=
# Push Notifications
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
