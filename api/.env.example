# Dorpwag™ API — Environment Variables
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/dorpwag_db
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Firebase (FCM Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# PayFast
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_RETURN_URL=https://api.dorpwag.vcds.co.za/payfast/return
PAYFAST_CANCEL_URL=https://api.dorpwag.vcds.co.za/payfast/cancel
PAYFAST_NOTIFY_URL=https://api.dorpwag.vcds.co.za/payfast/notify

# Sentry
SENTRY_DSN=your-sentry-dsn-here

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Google Maps
GOOGLE_MAPS_API_KEY=your-maps-api-key

# PostHog Analytics
POSTHOG_API_KEY=your-posthog-key

# Hikvision LPR (Camera integration)
HIKVISION_HOST=your-hikvision-host
HIKVISION_USER=admin
HIKVISION_PASS=your-password
