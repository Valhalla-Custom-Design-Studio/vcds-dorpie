{
  "name": "vcds-dorpwag-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests --forceExit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.0",
    "axios": "^1.6.2",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "ts-jest": "^29.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.8"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/../tests/unit"],
    "testMatch": ["**/*.test.ts"]
  }
}
