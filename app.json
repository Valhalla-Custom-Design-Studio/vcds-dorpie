{
  "expo": {
    "name": "Dorpwag™",
    "slug": "dorpwag",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#021A1A"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.vcds.dorpwag",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dorpwag™ gebruik jou ligging vir Guardian Mode™ veiligheidsmonitering.",
        "NSLocationAlwaysUsageDescription": "Dorpwag™ benodig agtergrondligging vir Guardian Mode™.",
        "NSMicrophoneUsageDescription": "Dorpwag™ benodig die mikrofoon vir Witness Mode™ bewyse.",
        "NSCameraUsageDescription": "Dorpwag™ gebruik die kamera vir foto's.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      },
      "config": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#021A1A"
      },
      "package": "co.za.vcds.dorpwag",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBIZnxrIO0Am1CHXPH1NgIyHbVmtXTilks"
        }
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Dorpwag™ to use your location for Guardian Mode™ safety monitoring."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "valhalla-custom-design-studios",
          "project": "dorpwag",
          "uploadSourceMaps": false,
          "uploadNativeSymbols": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "dorpie",
    "extra": {
      "apiUrl": "https://dorpwag-api.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d3584967-0809-49bd-a13b-9ef5915eebdd"
      }
    },
    "owner": "valhalla-custom-design-studios-org"
  }
}